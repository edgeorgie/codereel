# Optional. Product analytics (PostHog) is off unless this public project token is set at build time.
# Without it the SDK is never downloaded and no analytics request is made. See docs/adr/0003-cookieless-product-analytics.md.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...

# GitHub Pages only: the static export cannot proxy /ingest, so point the SDK at PostHog directly.
# Leave unset on Vercel, where events go through the same-origin /ingest rewrite.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
